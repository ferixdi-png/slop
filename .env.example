# ДЛЯ ЗАПУСКА НУЖНЫ ТОЛЬКО ЭТИ 2 КЛЮЧА

# 1. Google AI Studio — полный production-анализ выбранного Reel
# и лёгкая проверка, можно ли исходник 10.05–15.05 сек естественно ужать до 10 сек.
GEMINI_API_KEY=your_api_key_here

# 2. Apify — три Instagram hashtag-feed: #omni, #veo, #veo3.
# V27 дополнительно проверяет реальный hashtag внутри самого поста; одного source-feed недостаточно.
APIFY_API_TOKEN=your_apify_token_here

# Рабочие значения по умолчанию. Обычно менять не нужно.
ANALYSIS_MODEL=gemini-3.5-flash
RADAR_MODEL=gemini-3.1-flash-lite
APIFY_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_CREATOR_ACTOR=apify/instagram-reel-scraper

# OMNI / VEO / VEO3 STRICT MOMENTUM RADAR
# resultsLimit применяется отдельно к каждому тегу:
# 250 #omni + 250 #veo + 250 #veo3 = до 750 raw Reels.
OMNI_VEO_HASHTAG_LIMIT=250

# До 420 лучших strict-кандидатов проходят фактическую MP4-проверку за run.
# <=10.05 сек: duration + motion локально.
# 10.05–15.05 сек: остаются только если механику можно естественно собрать ровно в 10.00 сек.
OMNI_VEO_ANALYZE_LIMIT=420

# Финальный TOP — до 180 лучших роликов.
OMNI_VEO_KEEP_LIMIT=180

# Hard-cap Apify на КАЖДЫЙ из трёх hashtag source.
# Runtime дополнительно не даст effective cap превысить $1.25/source.
OMNI_VEO_SOURCE_CAP_USD=1.00

# Если нужен максимально широкий режим и Render выдерживает нагрузку:
# OMNI_VEO_ANALYZE_LIMIT=500
# OMNI_VEO_KEEP_LIMIT=300

# Legacy fallback values. Финальный V27 runtime-профиль переопределяет их.
APIFY_SEARCH_LIMIT=64
APIFY_HASHTAG_LIMIT=80
RADAR_AI_ANALYZE_LIMIT=60
RADAR_KEEP_LIMIT=30

MAX_UPLOAD_MB=120
DB_PATH=data/slop.db
