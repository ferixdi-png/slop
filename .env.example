# V30 — для запуска нужны только 2 внешних ключа.

# 1. Gemini: speech/timing screening + production-анализ выбранного ролика.
GEMINI_API_KEY=your_api_key_here

# 2. Apify: Instagram + TikTok + YouTube discovery и durable KVS state mirror.
APIFY_API_TOKEN=your_apify_token_here

# Модели. Текущий production runtime использует эти значения по умолчанию.
ANALYSIS_MODEL=gemini-3.1-flash-lite
RADAR_MODEL=gemini-3.1-flash-lite

# V30 discovery Actors. Обычно менять не нужно.
APIFY_V28_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_V28_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_V28_YOUTUBE_ACTOR=constructive_calm/youtube-shorts-scraper-pro

# Финальный V30 runtime сам фиксирует экономику поиска:
# - 5 тегов: #omni #veo #veo3 #ai #ии
# - 14 дней
# - 60 результатов на тег/платформу = максимум 300 на платформу / 900 raw
# - Instagram hard cap $0.85
# - TikTok hard cap $1.15
# - YouTube hard cap $0.80
# - discovery hard cap $2.80
# - максимум 150 кандидатов на speech/timing screening
# - максимум 180 automatic AI ticks с учётом retry allowance
# - manual/on-demand refresh: maxItems=1 и hard cap $0.12
# Эти значения намеренно задаются кодом, чтобы старый Render env не мог случайно
# расширить платный run.

# Legacy Actor values нужны старым внутренним слоям bootstrap, но V30 discovery
# переопределяет их финальным three-platform source set.
APIFY_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_CREATOR_ACTOR=apify/instagram-reel-scraper

MAX_UPLOAD_MB=120
DB_PATH=data/slop.db
