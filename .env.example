# ОБЯЗАТЕЛЬНО: анализ видео
GEMINI_API_KEY=your_api_key_here

# ОБЯЗАТЕЛЬНО: радар Instagram через Apify
APIFY_API_TOKEN=your_apify_token_here

# Модели анализа. Можно менять без правок кода.
ANALYSIS_MODEL=gemini-3.5-flash
RADAR_MODEL=gemini-3.1-flash-lite

# Apify actors
APIFY_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_CREATOR_ACTOR=apify/instagram-reel-scraper
APIFY_SEARCH_LIMIT=64
APIFY_HASHTAG_LIMIT=80

# Сколько кандидатов после фильтра <=10 сек и 7 дней прогонять через AI
RADAR_AI_ANALYZE_LIMIT=60
RADAR_KEEP_LIMIT=30

# Защита ручного запуска синхронизации
RADAR_SYNC_KEY=change-this-secret

# Сервер
SECRET_KEY=change-me
MAX_UPLOAD_MB=120
# Для постоянного диска Render можно указать /var/data/slop.db
DB_PATH=data/slop.db

# Одна фиксированная партнёрка для блока публикации
AFFILIATE_NAME=
AFFILIATE_URL=
AFFILIATE_CTA=
