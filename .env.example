# ДЛЯ ЗАПУСКА НУЖНЫ ТОЛЬКО ЭТИ 2 КЛЮЧА

# 1. Google AI Studio — полный production-анализ выбранного Reel и meta TOP
GEMINI_API_KEY=your_api_key_here

# 2. Apify — глубокий сбор Instagram Reels только по #omni и #veo
APIFY_API_TOKEN=your_apify_token_here

# Рабочие значения по умолчанию. Обычно менять не нужно.
ANALYSIS_MODEL=gemini-3.5-flash
RADAR_MODEL=gemini-3.1-flash-lite
APIFY_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_CREATOR_ACTOR=apify/instagram-reel-scraper

# OMNI / VEO MASS MOMENTUM RADAR
# resultsLimit применяется отдельно к каждому тегу: 250 #omni + 250 #veo = до 500 raw Reels.
OMNI_VEO_HASHTAG_LIMIT=250
# Сколько коротких кандидатов максимум реально скачать и проверить по MP4 за один run.
OMNI_VEO_ANALYZE_LIMIT=500
# Максимальный размер финального TOP. /api/radar сейчас физически отдаёт не более 300.
OMNI_VEO_KEEP_LIMIT=300
# Hard-cap Apify на КАЖДЫЙ из двух hashtag source.
OMNI_VEO_SOURCE_CAP_USD=1.00

# Legacy fallback values. Финальный V22-профиль переопределяет их в runtime.
APIFY_SEARCH_LIMIT=64
APIFY_HASHTAG_LIMIT=80
RADAR_AI_ANALYZE_LIMIT=60
RADAR_KEEP_LIMIT=30

MAX_UPLOAD_MB=120
DB_PATH=data/slop.db
