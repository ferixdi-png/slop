# FINAL V37 — для production нужны только 2 внешних ключа.

# 1. Gemini: optional automatic enrichment + production-анализ выбранного ролика.
GEMINI_API_KEY=your_api_key_here

# 2. Apify: Instagram + TikTok + YouTube discovery, media refresh и durable KVS mirror.
APIFY_API_TOKEN=your_apify_token_here

# Gemini model намеренно НЕ настраивается через env.
# config.py фиксирует gemini-3.1-flash-lite, чтобы старый Render env не мог
# незаметно изменить стоимость или поведение screening/production pipeline.

# Финальные discovery Actors. Обычно менять не нужно.
APIFY_V28_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_V28_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_V28_YOUTUBE_ACTOR=constructive_calm/youtube-shorts-scraper-pro

# Финальный runtime фиксирует экономику поиска в коде:
# - платформы: Instagram Reels + TikTok + YouTube Shorts
# - 5 тегов: #omni #veo #veo3 #ai #ии
# - 14 дней
# - 60 результатов на тег/платформу = максимум 300 на платформу / 900 raw
# - Instagram hard cap $0.85
# - TikTok hard cap $1.15
# - YouTube hard cap $0.80
# - discovery hard cap $2.80
# - reserved headroom $2.20 / hard target $5.00
# - максимум 150 числовых кандидатов после discovery
# - Gemini enrichment только до 20 лидеров broad-pool
# - persistent guard максимум 180 automatic AI ticks с retry allowance
# - manual/on-demand refresh: maxItems=1 и hard cap $0.12
# Старые Render env не могут расширить эти paid-run limits.

# Legacy Actor values нужны только внутренним compatibility-слоям bootstrap.
# Финальный V28/V29 source set всегда переопределяет discovery на три платформы выше.
APIFY_SEARCH_ACTOR=apify/instagram-search-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper
APIFY_CREATOR_ACTOR=apify/instagram-reel-scraper

MAX_UPLOAD_MB=120
DB_PATH=data/slop.db
